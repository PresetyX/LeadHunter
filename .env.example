# Segredo das sessões (obrigatório): openssl rand -base64 48
AUTH_SECRET=

# Armazenamento (um dos dois)
BLOB_READ_WRITE_TOKEN=
# DATABASE_URL=

# Mercado Pago (Checkout Pro: Pix e cartão)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Busca de leads — ordem: Google Places (principal) → Outscraper (opcional) → OpenStreetMap
PLACES_API_KEY=             # Google Cloud Places API (New) — restrinja a chave à Places API
# PLACES_MONTHLY_CALL_CAP=900  # teto global de chamadas/mês (cota grátis Enterprise = 1.000; depois US$ 35/1.000)
# GOOGLE_MAX_CALLS_PER_SEARCH=18
# SCRAPER_API_KEY=          # Outscraper (opcional, só usado se o Google não trouxer resultados)
# OUTSCRAPER_QUERY_VARIANTS=1

# Preços: auto (padrão: vitalício enquanto vendas < 50) | launch | monthly
# PRICING_MODE=
# ADMIN_EMAILS=voce@exemplo.com   # quem vê o dev-toggle em produção
# PRICING_DEV_TOGGLE=1      # mostra o seletor para TODOS (evite em produção)

# URL pública do app (na Vercel é inferida)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# Teste local sem Blob/Postgres (somente fora da Vercel): armazenamento em memória
# LEADHUNTER_TEST_MEMORY_STORE=1
